// conspectus · M1 数据模型
// 依据 docs/design.md §6.2。Prisma 无法表达的约束（部分唯一、表达式索引、
// 条件 CHECK、DEFERRABLE 组合外键、Vendor 触发器）见 prisma/migrations/*/constraints.sql。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  suspended
}

enum UserStatusReason {
  admin
  certus_locked
  certus_disabled
}

enum CertusLinkStatus {
  active
  reauth_required
}

enum EmailVerificationSource {
  local
  certus
}

enum SessionAuthMethod {
  certus
  local
}

enum VendorCategory {
  streaming
  ai
  cloud
  dev_tool
  storage
  domain
  music
  news
  game
  other
}

enum SubscriptionStatus {
  trial
  active
  paused
  canceled
  expired
}

enum BillingCycle {
  weekly
  monthly
  quarterly
  yearly
  custom
  lifetime
  one_time
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  certusSub     String?  @unique @db.Text
  /// Pre-#94 digest; matched once on login, then cleared. Never written anew.
  certusSubLegacy String? @unique @db.Text
  email         String?  @db.Text
  emailVerifiedAt DateTime?
  emailVerificationSource EmailVerificationSource?
  lastStatusSyncedAt DateTime?
  certusLinkStatus CertusLinkStatus?
  statusCheckFailureCount Int @default(0)
  nextStatusCheckAt DateTime?
  statusSyncLeaseUntil DateTime?
  statusSyncLeaseToken String? @db.Uuid
  lastStatusSyncError String? @db.Text
  passwordHash  String? @db.Text
  failedLoginCount Int @default(0)
  lockedUntil   DateTime?
  name          String? @db.Text
  baseCurrency  String  @default("CNY") @db.Char(3)
  timezone      String  @default("Asia/Shanghai") @db.Text
  inboundAddress String? @unique @db.Text
  /// 邮件原文保留开关（§7.5/§9）：false 时 InboundEmail.rawCipher 始终为空
  inboundRetainRaw Boolean @default(true)
  status        UserStatus @default(active)
  statusReason  UserStatusReason?
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  sessions   Session[]
  reauthTransactions ReauthTransaction[]
  subscriptions Subscription[]
  vendors    Vendor[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  billingRecords BillingRecord[]
  billingConversions BillingConversion[]
  paymentMethods PaymentMethod[]
  currencyRebaseJobs CurrencyRebaseJob[]
  usageQuotas UsageQuota[]
  usageBindings UsageBinding[]
  usageSnapshots UsageSnapshot[]
  usageCycleSummaries UsageCycleSummary[]
  providerConnections ProviderConnection[]
  notificationRules NotificationRule[]
  notificationChannels NotificationChannel[]
  notificationEvents NotificationEvent[]
  notificationDeliveries NotificationDelivery[]
  notificationDigests NotificationDigest[]
  notificationArmStates NotificationArmState[]
  priceChanges PriceChange[]
  collectorDevices CollectorDevice[]
  inboundEmails InboundEmail[]
  importDrafts ImportDraft[]

  @@index([status])
  @@index([certusLinkStatus])
  @@index([nextStatusCheckAt])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash Bytes    @unique
  authMethod SessionAuthMethod
  idleExpiresAt  DateTime @db.Timestamptz
  absoluteExpiresAt DateTime @db.Timestamptz
  lastSeenAt DateTime @db.Timestamptz
  certusSid String? @db.Text
  certusRefreshTokenCipher Bytes?
  certusIdTokenCipher Bytes?
  lastIdentityCheckedAt DateTime? @db.Timestamptz
  authTime  DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([certusSid])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

model BackchannelLogoutReplay {
  issuer String @db.Text
  jti    String @db.Text
  expiresAt DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz

  @@id([issuer, jti])
  @@index([expiresAt])
  @@map("backchannel_logout_replays")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash Bytes    @unique
  expiresAt DateTime @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  email     String   @db.Text
  tokenHash Bytes    @unique
  expiresAt DateTime @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model RateLimitCounter {
  scope         String   @db.Text
  keyHash       String   @db.Char(64)
  windowStart   DateTime @db.Timestamptz
  windowEndsAt  DateTime @db.Timestamptz
  attemptCount  Int      @default(1)

  @@id([scope, keyHash])
  @@index([windowEndsAt])
  @@map("rate_limit_counters")
}

/**
 * /api/ready?deep=1 的跨实例缓存与 single-flight（§5.4）：结果按
 * issuer+client_id 缓存 60s，lease 保证同一时刻全集群最多一个 worker
 * 请求 certus；body 内含上游 configRevision，供运维比对两次探测。
 */
model DeepReadyProbe {
  cacheKey   String    @id @db.Text
  body       Json
  checkedAt  DateTime  @db.Timestamptz
  leaseUntil DateTime? @db.Timestamptz
  leaseToken String?   @db.Uuid

  @@map("deep_ready_probes")
}

model ReauthTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  sessionId String   @db.Uuid
  action    String   @db.Text
  /// Post-reauth destination, kept server-side so it cannot be tampered with (#98).
  targetPath String? @db.Text
  tokenHash Bytes    @unique
  expiresAt DateTime @db.Timestamptz
  verifiedAt DateTime? @db.Timestamptz
  consumedAt DateTime? @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("reauth_transactions")
}

model Vendor {
  id        String @id @default(uuid()) @db.Uuid
  slug      String @db.Text
  name      String @db.Text
  category  VendorCategory
  homepage  String? @db.Text
  cancelUrl String? @db.Text
  logoUrl   String? @db.Text
  userId    String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@map("vendors")
}

model Subscription {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  vendorId   String? @db.Uuid
  name       String @db.Text
  planName   String? @db.Text
  status     SubscriptionStatus
  price      Decimal @db.Decimal(14, 2)
  currency   String @db.Char(3)
  billingCycle BillingCycle
  cycleDays  Int?
  anchorDay  Int?
  startedAt  DateTime @db.Date
  nextBillingAt DateTime? @db.Date
  endedAt    DateTime? @db.Date
  trialEndsAt DateTime? @db.Date
  autoRenew  Boolean @default(true)
  paymentMethodId String? @db.Uuid
  tags       String[] @default([])
  notes      String? @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor? @relation(fields: [vendorId], references: [id])
  billingRecords BillingRecord[]
  usageQuotas UsageQuota[]
  priceChanges PriceChange[]
  importDrafts ImportDraft[]
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  @@index([userId, status])
  @@index([userId, nextBillingAt])
  @@index([userId, vendorId])
  @@map("subscriptions")
}

enum BillingRecordType {
  charge
  refund
}

enum BillingRecordStatus {
  paid
  pending
  failed
  void
}

enum BillingRecordSource {
  manual
  email
  csv
  system
}

model BillingRecord {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  subscriptionId String @db.Uuid
  amount     Decimal @db.Decimal(14, 2)
  currency   String @db.Char(3)
  recordType BillingRecordType
  originalRecordId String? @db.Uuid
  billedAt   DateTime @db.Date
  periodStart DateTime? @db.Date
  periodEnd  DateTime? @db.Date
  status     BillingRecordStatus
  source     BillingRecordSource
  externalRef String? @db.Text
  occurrenceKey String? @unique @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  originalRecord BillingRecord? @relation("BillingAdjustment", fields: [originalRecordId], references: [id])
  adjustments BillingRecord[] @relation("BillingAdjustment")
  conversions BillingConversion[]

  @@unique([userId, externalRef])
  @@index([userId, subscriptionId, recordType])
  @@index([userId, billedAt])
  @@index([subscriptionId, occurrenceKey])
  @@map("billing_records")
}

model BillingConversion {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  billingRecordId String @db.Uuid
  baseCurrency String @db.Char(3)
  signedAmountInBase Decimal @db.Decimal(14, 2)
  fxRate     Decimal @db.Decimal(18, 8)
  fxDate     DateTime @db.Date
  rateSource String @default("provider") @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingRecord BillingRecord @relation(fields: [billingRecordId], references: [id])

  @@unique([billingRecordId, baseCurrency])
  @@index([userId, baseCurrency])
  @@map("billing_conversions")
}

enum PaymentMethodKind {
  credit_card
  debit_card
  alipay
  wechat
  paypal
  other
}

model PaymentMethod {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  label     String @db.Text
  kind      PaymentMethodKind
  last4     String? @db.Char(4)
  expiresAt DateTime? @db.Date
  notes     String? @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([userId])
  @@map("payment_methods")
}

model ExchangeRate {
  date   DateTime @db.Date
  base   String   @db.Char(3)
  quote  String   @db.Char(3)
  rate   Decimal  @db.Decimal(18, 8)
  // 抓取失败回退到上一个可用日期时置 true（design §7.3，#106）；新鲜 fix 落表复位
  stale  Boolean  @default(false)

  @@id([date, base, quote])
  @@map("exchange_rates")
}

model CurrencyRebaseJob {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  fromCurrency String @db.Char(3)
  toCurrency String @db.Char(3)
  status    String @default("pending") @db.Text
  totalCount Int @default(0)
  doneCount Int @default(0)
  lastError String? @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status])
  @@map("currency_rebase_jobs")
}

enum UsageKind {
  quota
  balance
  counter
}

enum UsageResetCycle {
  daily
  weekly
  monthly
  billing_cycle
  never
}

enum UsageSource {
  manual
  provider
  local_agent
}

enum UsageSyncStatus {
  ok
  auth_failed
  rate_limited
  error
}

enum BindingStatus {
  active
  revoked
}

model UsageQuota {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  subscriptionId String @db.Uuid
  kind       UsageKind
  metric     String @db.Text
  unit       String @db.Text
  limitValue Decimal? @db.Decimal(20, 4)
  usedValue  Decimal? @db.Decimal(20, 4)
  remainingValue Decimal? @db.Decimal(20, 4)
  resetCycle UsageResetCycle
  periodStart DateTime? @db.Timestamptz
  periodEnd  DateTime? @db.Timestamptz
  authoritativeBindingId String? @db.Uuid
  valueSnapshotId String? @db.Uuid
  lastSyncedAt DateTime? @db.Timestamptz
  valueCapturedAt DateTime? @db.Timestamptz
  lastSyncStatus UsageSyncStatus?
  lastSyncError String? @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  bindings UsageBinding[]
  snapshots UsageSnapshot[]
  cycleSummaries UsageCycleSummary[]

  @@unique([subscriptionId, metric])
  @@index([userId, kind])
  @@map("usage_quotas")
}

model UsageBinding {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  quotaId    String @db.Uuid
  source     UsageSource
  sourceKey  String @db.Text
  connectionId String? @db.Uuid
  collectorId String? @db.Text
  status     BindingStatus @default(active)
  createdAt  DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quota UsageQuota @relation(fields: [quotaId], references: [id], onDelete: Cascade)
  providerConnection ProviderConnection? @relation(fields: [connectionId], references: [id])
  snapshots UsageSnapshot[]

  @@unique([quotaId, source, sourceKey])
  @@index([userId, status])
  @@map("usage_bindings")
}

model UsageSnapshot {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  quotaId    String @db.Uuid
  bindingId  String @db.Uuid
  capturedAt DateTime @db.Timestamptz
  kindAtCapture UsageKind
  unitAtCapture String @db.Text
  value      Decimal @db.Decimal(20, 4)
  limitValueAtCapture Decimal? @db.Decimal(20, 4)
  periodStart DateTime? @db.Timestamptz
  periodEnd  DateTime? @db.Timestamptz
  deviceId   String? @db.Uuid
  raw        String? @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quota UsageQuota @relation(fields: [quotaId], references: [id], onDelete: Cascade)
  binding UsageBinding @relation(fields: [bindingId], references: [id])

  @@index([quotaId, capturedAt])
  @@index([userId, quotaId])
  @@map("usage_snapshots")
}

model UsageCycleSummary {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  quotaId    String @db.Uuid
  periodStart DateTime @db.Timestamptz
  periodEnd  DateTime @db.Timestamptz
  finalValue Decimal @db.Decimal(20, 4)
  limitValueAtClose Decimal? @db.Decimal(20, 4)
  utilizationAtClose Decimal? @db.Decimal(10, 4)
  unitAtClose String @db.Text
  authoritativeBindingIdAtClose String? @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quota UsageQuota @relation(fields: [quotaId], references: [id], onDelete: Cascade)

  @@unique([quotaId, periodStart])
  @@index([userId])
  @@map("usage_cycle_summaries")
}

enum ConnectionStatus {
  active
  auth_failed
  degraded
  disabled
}

model ProviderConnection {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  providerId String @db.Text
  displayName String @db.Text
  credentialKeyId String @db.Text
  credentialCipher Bytes
  credentialIv Bytes
  credentialTag Bytes
  status     ConnectionStatus @default(active)
  scopes     String[] @default([])
  lastSyncAt DateTime? @db.Timestamptz
  lastError  String? @db.Text
  syncFailureCount Int @default(0)
  nextSyncAt DateTime? @db.Timestamptz
  syncLeaseUntil DateTime? @db.Timestamptz
  syncLeaseToken String? @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bindings UsageBinding[]

  @@index([userId, providerId])
  @@index([status, nextSyncAt])
  @@map("provider_connections")
}

enum NotificationRuleType {
  renewal_due
  trial_ending
  usage_threshold
  balance_low
  collector_stale
  price_change
  connection_failed
}

enum NotificationChannelType {
  email
  webhook
}

enum NotificationChannelMode {
  individual
  daily_digest
}

enum NotificationEventStatus {
  pending
}

enum NotificationDeliveryStatus {
  pending
  sending
  sent
  failed
  blocked
  canceled
}

enum NotificationDigestStatus {
  pending
  sending
  sent
  failed
  blocked
  canceled
}

model NotificationRule {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  type       NotificationRuleType
  config     Json
  subscriptionId String? @db.Uuid
  enabled    Boolean @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  events NotificationEvent[]
  armStates NotificationArmState[]

  @@index([userId, enabled])
  @@map("notification_rules")
}

model NotificationChannel {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  type       NotificationChannelType
  mode       NotificationChannelMode @default(individual)
  digestLocalTime DateTime? @db.Time(6)
  destination String? @db.Text
  secretCipher Bytes?
  verifiedAt DateTime? @db.Timestamptz
  enabled    Boolean @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]
  digests NotificationDigest[]

  @@index([userId, enabled])
  @@map("notification_channels")
}

model NotificationEvent {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  ruleId     String @db.Uuid
  subjectType String @db.Text
  subjectId  String @db.Uuid
  dedupeKey  String @db.Text
  payload    Json
  occurredAt DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule NotificationRule @relation(fields: [ruleId], references: [id])
  deliveries NotificationDelivery[]

  @@unique([userId, ruleId, subjectType, subjectId, dedupeKey])
  @@index([userId, occurredAt])
  @@map("notification_events")
}

model NotificationDelivery {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  eventId    String @db.Uuid
  channelId  String @db.Uuid
  digestId   String? @db.Uuid
  scheduledAt DateTime @db.Timestamptz
  status     NotificationDeliveryStatus @default(pending)
  deferredReason String? @db.Text
  attempts   Int @default(0)
  nextAttemptAt DateTime? @db.Timestamptz
  leaseUntil DateTime? @db.Timestamptz
  leaseToken String? @db.Uuid
  lastError  String? @db.Text
  sentAt     DateTime? @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  event NotificationEvent @relation(fields: [eventId], references: [id])
  channel NotificationChannel @relation(fields: [channelId], references: [id])
  digest NotificationDigest? @relation(fields: [digestId], references: [id])

  @@unique([eventId, channelId])
  @@index([userId, status, nextAttemptAt])
  @@map("notification_deliveries")
}

model NotificationDigest {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  channelId  String @db.Uuid
  localDate  DateTime @db.Date
  scheduledAt DateTime @db.Timestamptz
  status     NotificationDigestStatus @default(pending)
  deferredReason String? @db.Text
  attempts   Int @default(0)
  nextAttemptAt DateTime? @db.Timestamptz
  leaseUntil DateTime? @db.Timestamptz
  leaseToken String? @db.Uuid
  lastError  String? @db.Text
  sentAt     DateTime? @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel NotificationChannel @relation(fields: [channelId], references: [id])
  deliveries NotificationDelivery[]

  @@unique([channelId, localDate])
  @@index([userId, status, scheduledAt])
  @@map("notification_digests")
}

model NotificationArmState {
  userId     String @db.Uuid
  ruleId     String @db.Uuid
  subjectType String @db.Text
  subjectId  String @db.Uuid
  armedAt    DateTime @db.Timestamptz
  armKey     String @db.Text
  clearedAt  DateTime? @db.Timestamptz
  meta       Json?
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule NotificationRule @relation(fields: [ruleId], references: [id])

  // 主键含 userId 维度（design §7.6）；组合外键 (userId, ruleId) →
  // notification_rules(userId, id) 由手写迁移声明，Prisma 无法表达
  @@id([userId, ruleId, subjectType, subjectId])
  @@map("notification_arm_states")
}

model PriceChange {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  subscriptionId String @db.Uuid
  oldPrice   Decimal @db.Decimal(14, 2)
  newPrice   Decimal @db.Decimal(14, 2)
  currency   String @db.Char(3)
  effectiveAt DateTime @db.Date
  detectedBy String @default("user") @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([userId, subscriptionId])
  @@map("price_changes")
}

model CollectorDevice {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  name       String @db.Text
  platform   String @db.Text
  /// 采集器自报；从未上报过版本的设备为空，不再由服务端编造缺省值
  agentVersion String? @db.Text
  publicKey  Bytes
  keyAlgorithm String @default("Ed25519") @db.Text
  lastSeenAt DateTime? @db.Timestamptz
  lastReportStatus String? @db.Text
  revokedAt  DateTime? @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
  @@map("collector_devices")
}

model CollectorNonce {
  deviceId String @db.Uuid
  nonce    String @db.Text
  seenAt   DateTime @db.Timestamptz

  @@id([deviceId, nonce])
  @@index([seenAt])
  @@map("collector_nonces")
}

// ---------- M6 邮件导入（#57，design §6.2 / §7.5） ----------

enum InboundEmailParseStatus {
  pending
  parsed
  failed
}

enum ImportDraftSource {
  email
  csv
}

enum ImportDraftStatus {
  pending
  accepted
  rejected
  expired
}

/**
 * 收件原始记录。唯一约束 (userId, messageId) 是入站幂等的底线：同一用户同一
 * messageId 并发/重试只落一行。rawCipher 为 envelope 加密的原文（§9），默认
 * 30 天后由 purge 置空（行保留）；用户关闭保留时 rawCipher/rawRetainedUntil
 * 恒为空。DB CHECK：rawCipher 非空时 rawRetainedUntil 必填（手写迁移）。
 */
model InboundEmail {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  messageId  String @db.Text
  fromAddr   String @db.Text
  subject    String @db.Text
  receivedAt DateTime @db.Timestamptz
  parseStatus InboundEmailParseStatus @default(pending)
  rawCipher  Bytes?
  rawRetainedUntil DateTime? @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([rawRetainedUntil])
  @@map("inbound_emails")
}

/**
 * 导入草稿：未经用户确认不进入 BillingRecord/实付统计（§7.5 底线）。payload
 * 为版本化 Zod schema（src/server/import/draft-payload.ts），不允许携带任意
 * HTML/脚本字段。suggestedSubscriptionId 的同租户约束由手写触发器兜底
 * （沿用 billing_record_tenant_check 模式）；引用订阅被删除时置空，草稿保留。
 * 过期草稿由 purge 置 expired（行保留）。
 */
model ImportDraft {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  source     ImportDraftSource
  payload    Json
  confidence Decimal @db.Decimal(4, 3)
  status     ImportDraftStatus @default(pending)
  suggestedSubscriptionId String? @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  expiresAt  DateTime @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestedSubscription Subscription? @relation(fields: [suggestedSubscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([expiresAt])
  @@map("import_drafts")
}
