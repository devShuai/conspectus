# Must match certus redirect_uris exactly (origin + path).
# Prefer 127.0.0.1 over localhost to avoid host mismatch with certus registration.
APP_URL=http://127.0.0.1:3000

CERTUS_ISSUER=https://certus.example.com

# Resource server / web SSO confidential client
CERTUS_CLIENT_ID=conspectus
CERTUS_CLIENT_SECRET=

# Public device-code client for M0 #6 / M4 collector path
CERTUS_CLI_CLIENT_ID=conspectus-cli
# CERTUS_CLI_SCOPE=openid profile usage:write
# Optional overrides if resource client ids differ from CERTUS_CLIENT_*:
# CERTUS_RESOURCE_CLIENT_ID=conspectus
# CERTUS_RESOURCE_CLIENT_SECRET=
