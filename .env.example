# Must match certus redirect_uris exactly (origin + path).
# Prefer 127.0.0.1 over localhost to avoid host mismatch with certus registration.
APP_URL=http://127.0.0.1:3000
# At least 32 bytes. Signs short-lived OIDC transaction cookies; rotate with
# care because rotation invalidates authorization flows already in progress.
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# PostgreSQL 16（192.168.1.202 或自有实例）
DATABASE_URL=postgres://conspectus:CHANGE_ME@192.168.1.202:5432/conspectus?sslmode=disable
# 集成测试库（与主库同 schema，migration 共用）
TEST_DATABASE_URL=postgres://conspectus:CHANGE_ME@192.168.1.202:5432/conspectus_test?sslmode=disable

CERTUS_ISSUER=https://certus.example.com

# Resource server / web SSO confidential client
CERTUS_CLIENT_ID=conspectus
CERTUS_CLIENT_SECRET=

# 敏感凭据加密（Session refresh/ID token、服务商凭证等）
# 格式：<keyId>:<base64 32字节>，逗号分隔；ACTIVE_CREDENTIAL_KEY_ID 指定新写入版本
CREDENTIAL_ENC_KEYS=v1:REPLACE_WITH_32_BYTE_BASE64
ACTIVE_CREDENTIAL_KEY_ID=v1

# 定时任务与部署探针（M1 必填；不得用占位值，二者必须不同）
CRON_SECRET=REPLACE_WITH_LONG_RANDOM
DEPLOY_PROBE_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM
# 身份状态 TTL / 陈旧上界（默认 1h / 24h；TTL 必须 < MAX_STALE）
# IDENTITY_STATUS_TTL=1h
# IDENTITY_STATUS_MAX_STALE=24h

# Public device-code client for M0 #6 / M4 collector path
CERTUS_CLI_CLIENT_ID=conspectus-cli
# CERTUS_CLI_SCOPE=openid profile usage:write
# Optional overrides if resource client ids differ from CERTUS_CLIENT_*:
# CERTUS_RESOURCE_CLIENT_ID=conspectus
# CERTUS_RESOURCE_CLIENT_SECRET=
