# 安装位置：~/.config/conspectus/conspectus.env，权限 0600。
# systemd EnvironmentFile 语法：KEY=value 逐行，**不做 shell 展开**，值不要加引号
# （引号会被当成值的一部分）。
#
# NODE_ENV / PORT / HOSTNAME 不在这里 —— 它们由 conspectus.service 写死，见该文件注释。
# TEST_DATABASE_URL 绝不能出现：§5.4 的启动闸门会直接拒绝启动（issue #64）。

APP_URL=https://conspectus.devshuai.com
AUTH_MODE=certus

CERTUS_ISSUER=https://certus.devshuai.com
CERTUS_CLIENT_ID=conspectus
CERTUS_CLIENT_SECRET=REPLACE_ME
CERTUS_CLI_CLIENT_ID=conspectus-cli

DATABASE_URL=postgres://conspectus:REPLACE_ME@127.0.0.1:5432/conspectus?sslmode=disable

# 必须与本地 .env.local 里的值逐字节一致：线上与开发指向同一个库，
# 换了密钥等于把已有的密文（Session refresh/ID token、服务商凭证）全部锁死。
CREDENTIAL_ENC_KEYS=REPLACE_ME
ACTIVE_CREDENTIAL_KEY_ID=v1

# 以下三个由 release.sh 首次运行时随机生成，不需要与开发环境相同。
# CRON_SECRET 与 DEPLOY_PROBE_SECRET 必须互不相同，否则启动闸门拒绝。
AUTH_SECRET=REPLACE_ME
CRON_SECRET=REPLACE_ME
DEPLOY_PROBE_SECRET=REPLACE_ME
